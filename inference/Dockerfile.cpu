# -------------------------
# Stage 1: Build
# -------------------------
FROM python:3.12-slim AS build

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Bootstrap pip with the advisory SHA256 before fetching other packages.
RUN python -m pip install --no-cache-dir --no-deps "pip @ https://files.pythonhosted.org/packages/3f/06/3e4420302363fbb71be3c7f35ce042f54bfca330e3e66b3a2e3c4cca579f/pip-26.2.2-py3-none-any.whl#sha256=fd7f4dfa8190e014013b9f08f3e973f4e4c26ffd179a204895533a7254813a70" && \
    python -m pip install --no-cache-dir --upgrade "pip>=26.2.2" setuptools wheel && \
    pip install --no-cache-dir torch==2.14.0 --index-url https://download.pytorch.org/whl/cpu

COPY requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Bundle the default checkpoint without loading the model or requiring a GPU.
RUN hf download NX-AI/TiRex-2 config.json model.safetensors \
    --local-dir /opt/models/tirex2 && \
    test -f /opt/models/tirex2/config.json && \
    test -f /opt/models/tirex2/model.safetensors

# -------------------------
# --- Stage 2: Runtime
# -------------------------
FROM python:3.12-slim

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    g++ ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Bring in packages installed in build stage
COPY --from=build /usr/local /usr/local

# Create non-root user
RUN useradd --create-home --uid 1000 --shell /bin/bash appuser

# Create a writable workdir owned by appuser
RUN install -d -o appuser -g appuser /home/appuser/app

# Now set WORKDIR (it already exists and is owned by appuser)
WORKDIR /home/appuser/app

COPY THIRD-PARTY-LICENSES.md .

# Copy app code; keep a single COPY with chown
COPY --chown=appuser:appuser app/ ./app/

# Load the bundled checkpoint locally, including when running without network access.
COPY --from=build --chown=appuser:appuser /opt/models/tirex2 /opt/models/tirex2
ENV MODEL_PATH=/opt/models/tirex2

USER appuser
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["python", "-m", "app.main"]
