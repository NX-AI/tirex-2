# -------------------------
# Builder (CUDA toolkit for JIT-compatible builds)
# -------------------------
FROM nvidia/cuda:12.8.1-cudnn-devel-ubuntu24.04 AS build

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.12 python3.12-venv python3.12-dev \
    build-essential git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN python3.12 -m venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"
# Bootstrap pip with the advisory SHA256 before fetching other packages.
RUN python -m pip install --no-cache-dir --no-deps "pip @ https://files.pythonhosted.org/packages/3f/06/3e4420302363fbb71be3c7f35ce042f54bfca330e3e66b3a2e3c4cca579f/pip-26.2.2-py3-none-any.whl#sha256=fd7f4dfa8190e014013b9f08f3e973f4e4c26ffd179a204895533a7254813a70" && \
    python -m pip install --no-cache-dir --upgrade "pip>=26.2.2" setuptools wheel

COPY requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Bundle the default checkpoint without loading the model or requiring a GPU.
RUN hf download NX-AI/TiRex-2 config.json model.safetensors \
    --local-dir /opt/models/tirex2 && \
    test -f /opt/models/tirex2/config.json && \
    test -f /opt/models/tirex2/model.safetensors

# -------------------------
# Runtime (keep devel for JIT at runtime)
# -------------------------
FROM nvidia/cuda:12.8.1-cudnn-devel-ubuntu24.04 AS runtime

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.12 python3.12-dev build-essential ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV CUDA_HOME=/usr/local/cuda \
    PATH="/opt/venv/bin:/usr/local/cuda/bin:${PATH}"

# Copy the Python environment and app packages from the build stage.
COPY --from=build /opt/venv /opt/venv

# IMPORTANT: create a writable workdir owned by ubuntu (fixes PermissionError)
RUN install -d -o ubuntu -g ubuntu /home/ubuntu/app
WORKDIR /home/ubuntu/app

COPY THIRD-PARTY-LICENSES.md .

# Keep your existing project layout (app/main.py, etc.)
COPY --chown=ubuntu:ubuntu app/ ./app/

# Optional: centralize JIT caches so you can persist them
RUN mkdir -p /var/cache/triton /var/cache/torchinductor /var/cache/torch_extensions && \
    chown -R ubuntu:ubuntu /var/cache/triton /var/cache/torchinductor /var/cache/torch_extensions
ENV TRITON_CACHE_DIR=/var/cache/triton \
    TORCHINDUCTOR_CACHE_DIR=/var/cache/torchinductor \
    TORCH_EXTENSIONS_DIR=/var/cache/torch_extensions \
    MODEL_DEVICE=cuda

# Load the bundled checkpoint locally, including when running without network access.
COPY --from=build --chown=ubuntu:ubuntu /opt/models/tirex2 /opt/models/tirex2
ENV MODEL_PATH=/opt/models/tirex2

USER ubuntu
EXPOSE 8000

# Simple healthcheck; adjust if you expose a /health endpoint instead
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
        CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health', timeout=10)"

# Start exactly like before to preserve imports inside app/
CMD ["python", "-m", "app.main"]
