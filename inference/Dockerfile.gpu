# -------------------------
# Builder (CUDA toolkit for JIT-compatible builds)
# -------------------------
FROM pytorch/pytorch:2.14.0-cuda13.0-cudnn9-devel AS build

COPY requirements.txt ./requirements.txt
RUN pip install --no-cache-dir --break-system-packages --root=/opt/app-root -r requirements.txt

# -------------------------
# Runtime (keep devel for JIT at runtime)
# -------------------------
FROM pytorch/pytorch:2.14.0-cuda13.0-cudnn9-devel AS runtime

# Copy the staged app packages into the base image Python installation.
COPY --from=build /opt/app-root/usr/local /usr/local

# IMPORTANT: create a writable workdir owned by ubuntu (fixes PermissionError)
RUN install -d -o ubuntu -g ubuntu /home/ubuntu/app
WORKDIR /home/ubuntu/app

COPY THIRD-PARTY-LICENSES.md .

# Keep your existing project layout (app/main.py, etc.)
COPY --chown=ubuntu:ubuntu app/ ./app/

# Optional: centralize JIT caches so you can persist them
RUN mkdir -p /var/cache/triton /var/cache/torchinductor /var/cache/torch_extensions && \
    chown -R ubuntu:ubuntu /var/cache/triton /var/cache/torchinductor /var/cache/torch_extensions
ENV TRITON_CACHE_DIR=/var/cache/triton \
    TORCHINDUCTOR_CACHE_DIR=/var/cache/torchinductor \
    TORCH_EXTENSIONS_DIR=/var/cache/torch_extensions \
    MODEL_DEVICE=cuda \
    MODEL_COMPILE=1

USER ubuntu
EXPOSE 8000

# Simple healthcheck; adjust if you expose a /health endpoint instead
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
        CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health', timeout=10)"

# Start exactly like before to preserve imports inside app/
CMD ["python", "-m", "app.main"]
